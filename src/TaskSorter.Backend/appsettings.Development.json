{
  "DataProtection": {
    "KeysPath": "../../.tasksorter-keys"
  },
  "ProfileRun": {
    "TimeoutSeconds": 240
  },
  "GitHub": {
    "RequestTimeoutSeconds": 45,
    "CacheEnabled": true,
    "CacheDurationSeconds": 300,
    "CacheMaxEntries": 1000,
    "QuotaProtectionEnabled": true,
    "QuotaReserveRequests": 50,
    "QuotaWarningRemaining": 250,
    "QuotaSnapshotTtlSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  }
}
